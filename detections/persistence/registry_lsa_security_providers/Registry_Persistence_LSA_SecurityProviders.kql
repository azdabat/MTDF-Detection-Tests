// ============================================================================
// COMPOSITE HUNT (L3): Registry_Persistence_LSA_SecurityProviders
// Author: Ala Dabat   |   MITRE: T1547.009 (LSA / SSP)
//
// TRUTH DOMAIN : DeviceRegistryEvents
// MINIMUM TRUTH: RegistryValueSet under Control\Lsa or Control\SecurityProviders
//                touching security/authentication/notification packages, SSP DLLs
//                or WDigest UseLogonCredential.
//
// Lab-tested build. Changes from the original, found by testing against Empire telemetry:
//  (1) Anchors are hive-agnostic. The original anchored on "hklm\..." (plus a typo'd
//      "hk lm\..."), but MDE writes HKEY_LOCAL_MACHINE\..., so neither ever matched.
//  (2) Control\SecurityProviders added: WDigest / SSP writes land there, not under Control\Lsa.
//  (3) "uselogoncredential" added to value indicators (WDigest downgrade).
// Portability conventions:
//  (a) iff(<cond>,1,0) not toint(<cond>)   (b) one extend per dependency layer
//  (c) writer signer from DeviceFileCertificateInfo (InitiatingProcessSigner is not a Defender column)
//  (d) lookback = 3650d so the 2019 OTRF capture is in window; production uses 14d.
// ============================================================================

let lookback = 3650d;   // LAB: production uses 14d

let TrustedPublishers = dynamic(["Microsoft Corporation","Microsoft Windows"]);
let TrustedInitiators = dynamic(["msiexec.exe","trustedinstaller.exe","sppsvc.exe"]);

let LsaKeys = dynamic([
  @"system\currentcontrolset\control\lsa",
  @"system\currentcontrolset\control\securityproviders"
]);

let LsaValueIndicators = dynamic([
  "security packages","notification packages","authentication packages",
  "osconfig","lsaextensionconfigdll","ssp","dll",
  "uselogoncredential","securityproviders"
]);

let UserWritableRx  = @"(?i)^[a-z]:\\(users|public|programdata|temp|downloads|appdata)\\";
let SafePathAnchors = dynamic([@"c:\windows\system32", @"c:\windows\syswow64"]);
let PayloadExtRx    = @"(?i)\.(dll|ocx)\b";

let OrgPrevalence =
  DeviceFileEvents
  | where Timestamp >= ago(30d) and Timestamp < ago(lookback)
  | where isnotempty(SHA256)
  | summarize WriterDeviceCount = dcount(DeviceId) by SHA256;

let Raw =
  DeviceRegistryEvents
  | where Timestamp >= ago(lookback)
  | where ActionType == "RegistryValueSet"
  | extend RK  = tolower(tostring(RegistryKey)),
           RVN = tolower(tostring(RegistryValueName)),
           RVD = tolower(tostring(RegistryValueData))
  | where RK has_any (LsaKeys)
  | where RVN has_any (LsaValueIndicators) or RVD has_any (LsaValueIndicators);

// Writer signer, Defender-native: InitiatingProcessSigner is not a Defender column, so the
// signer comes from certificate data keyed on the writing process's SHA1.
let WriterCerts =
  DeviceFileCertificateInfo
  | where Timestamp >= ago(3650d)   // LAB: production uses 30d
  | where isnotempty(SHA1)
  | summarize arg_max(Timestamp, Signer, IsTrusted) by SHA1
  | project CertSHA1 = SHA1, CertSigner = tostring(Signer), CertTrusted = IsTrusted;

let Enriched =
  Raw
  | extend
      WriterFile    = tostring(InitiatingProcessFileName),
      WriterCL      = tostring(InitiatingProcessCommandLine),
      WriterSHA     = tostring(InitiatingProcessSHA256),
      WriterSHA1    = tostring(InitiatingProcessSHA1),
      WriterCompany = tostring(InitiatingProcessVersionInfoCompanyName),
      WriterUser    = tostring(InitiatingProcessAccountName)
  | join kind=leftouter WriterCerts on $left.WriterSHA1 == $right.CertSHA1
  | extend
      WriterSigner        = tostring(CertSigner),
      WriterSignerTrusted = iff(CertTrusted == true, 1, 0),
      WriterFileL = tolower(coalesce(WriterFile, ""))
  | extend
      WriterTrustedPublisher = iff(WriterCompany in (TrustedPublishers) or (WriterSigner in (TrustedPublishers) and WriterSignerTrusted == 1), 1, 0),
      WriterTrustedInitiator = iff(WriterFileL in (TrustedInitiators), 1, 0)
  | join kind=leftouter OrgPrevalence on $left.WriterSHA == $right.SHA256
  | extend WriterDeviceCount = coalesce(WriterDeviceCount, 0)
  | extend WriterIsRare = iff(isnotempty(WriterSHA) and WriterDeviceCount <= 2, 1, 0);

Enriched
| extend
    HasDllRef        = iff(RVD matches regex PayloadExtRx, 1, 0),
    PointsWritable   = iff(RVD matches regex UserWritableRx, 1, 0),
    IsSafeSystemPath = iff(RVD has_any (SafePathAnchors), 1, 0),
    UntrustedWriter  = iff(WriterTrustedPublisher == 0, 1, 0)
| where not(WriterTrustedPublisher == 1 and IsSafeSystemPath == 1 and PointsWritable == 0 and WriterIsRare == 0)
| where not(WriterTrustedInitiator == 1 and PointsWritable == 0 and WriterIsRare == 0 and UntrustedWriter == 0)
| extend
    BaseScore             = 70,
    Score_Writable        = 25 * PointsWritable,
    Score_UntrustedWriter = 20 * UntrustedWriter,
    Score_RareWriter      = 15 * WriterIsRare,
    Score_NonSystemPath   = 20 * iff(IsSafeSystemPath == 0 and HasDllRef == 1, 1, 0)
| extend
    RiskScore = BaseScore + Score_Writable + Score_UntrustedWriter + Score_RareWriter + Score_NonSystemPath
| extend
    RiskLevel = case(RiskScore >= 120, "CRITICAL",
                     RiskScore >= 95,  "HIGH",
                                       "MEDIUM")
// [DEPLOY] Timestamp, DeviceId and ReportId in the output: required to deploy as a Defender custom detection.
| project
    Timestamp, DeviceId, ReportId, DeviceName,
    AccountName       = WriterUser,
    RegistryKey, RegistryValueName, RegistryValueData,
    WriterProcess     = WriterFile,
    WriterCommandLine = WriterCL,
    WriterCompany, WriterSigner, WriterSHA, WriterDeviceCount,
    PointsWritable, RiskScore, RiskLevel
| extend HunterDirective = case(
    RiskLevel == "CRITICAL",
        "CRITICAL: LSA/SSP persistence modified. Treat as credential-compromise enabling. Validate provider DLL location + signer, isolate host if unauthorized, collect evidence, scope fleet for same RegistryValueData.",
    RiskLevel == "HIGH",
        "HIGH: LSA persistence change. Confirm change control. If unknown, escalate and scope for logon anomalies / credential dumping follow-on.",
        "MEDIUM: LSA-related change. Validate against baseline and change approvals.")
| order by RiskScore desc, Timestamp desc
