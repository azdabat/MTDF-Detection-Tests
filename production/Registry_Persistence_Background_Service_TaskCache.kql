// ============================================================================
// COMPOSITE HUNT (L3): Registry_Persistence_Background_Service_TaskCache
// Author: Ala Dabat   |   MITRE: T1543.003, T1053.005
//
// Lab-tested build. Original FIX-1..FIX-4 logic intact. Portability conventions:
//  (a) flags use iff(<cond>,1,0), not toint(<cond>)   (emulator rejects arithmetic on toint)
//  (b) one extend per dependency layer               (emulator can't resolve same-extend refs)
//  (c) base64_decode_tostring()                      (base64_decode_string does not exist)
//  (d) writer signer from DeviceFileCertificateInfo (InitiatingProcessSigner is not a Defender column)
//  (e) lookback = 3650d so the 2020 OTRF capture is in window; production uses 14d.
// ============================================================================

let lookback = 14d;

let TrustedPublishers  = dynamic(["Microsoft Corporation","Microsoft Windows",
                                   "Google LLC","Mozilla Corporation"]);
let TrustedInitiators  = dynamic(["msiexec.exe","trustedinstaller.exe","sppsvc.exe",
                                   "intunemanagementextension.exe","updateinstaller.exe"]);
let BackgroundKeys = dynamic([
  @"system\currentcontrolset\services",
  @"software\microsoft\windows nt\currentversion\schedule\taskcache\tree",
  @"software\microsoft\windows nt\currentversion\schedule\taskcache\tasks"
]);
let UserWritableRx  = @"(?i)^[a-z]:\\(users|public|programdata|temp|downloads|appdata)\\";
let Base64ChunkedRx = @"(?:[A-Za-z0-9+/]{20,}={0,2})(?:\s+[A-Za-z0-9+/]{20,}={0,2})+";
let IPv4Rx          = @"\b(?:(?:25[0-5]|2[0-4]\d|1?\d?\d)\.){3}(?:25[0-5]|2[0-4]\d|1?\d?\d)\b";
let DomainRx        = @"\b([a-z0-9][a-z0-9-]{1,62}\.)+[a-z]{2,}\b";
let UrlRx           = @"https?://[^\s'""<>]+";
let DangerTokens = dynamic([
  "powershell","pwsh","cmd.exe","mshta","rundll32","regsvr32","wscript","cscript",
  "certutil","bitsadmin","curl","-enc","-encodedcommand","frombase64string","http:","https:"
]);
let SafePathAnchors    = dynamic([@"c:\program files", @"c:\program files (x86)",
                                   @"c:\windows\system32", @"c:\windows\syswow64"]);
let SafeVendorKeywords = dynamic(["windows update","microsoft","google","edge","mozilla",
                                   "firefox","onedrive","teams","intel","nvidia","amd",
                                   "realtek","adobe","citrix"]);
let PayloadSizeThreshold = 500;

// [FIX-1] prevalence window ends at ago(lookback)
let OrgPrevalence =
  DeviceFileEvents
  | where Timestamp >= ago(30d) and Timestamp < ago(lookback)
  | where isnotempty(SHA256)
  | summarize WriterDeviceCount = dcount(DeviceId) by SHA256;

let Raw =
  DeviceRegistryEvents
  | where Timestamp >= ago(lookback)
  | where ActionType == "RegistryValueSet"
  | extend RK = tolower(tostring(RegistryKey)),
           RVN = tolower(tostring(RegistryValueName)),
           RVD = tolower(tostring(RegistryValueData))
  | where RK has_any (BackgroundKeys);

// Writer signer, Defender-native: InitiatingProcessSigner is not a Defender column, so the
// signer comes from certificate data keyed on the writing process's SHA1.
let WriterCerts =
  DeviceFileCertificateInfo
  | where Timestamp >= ago(30d)
  | where isnotempty(SHA1)
  | summarize arg_max(Timestamp, Signer, IsTrusted) by SHA1
  | project CertSHA1 = SHA1, CertSigner = tostring(Signer), CertTrusted = IsTrusted;

let Enriched =
  Raw
  | extend
      WriterFile    = tostring(InitiatingProcessFileName),
      WriterCL      = tostring(InitiatingProcessCommandLine),
      WriterSHA     = tostring(InitiatingProcessSHA256),
      WriterSHA1    = tostring(InitiatingProcessSHA1),
      WriterCompany = tostring(InitiatingProcessVersionInfoCompanyName),
      WriterUser    = tostring(InitiatingProcessAccountName)
  | join kind=leftouter WriterCerts on $left.WriterSHA1 == $right.CertSHA1
  | extend
      WriterSigner        = tostring(CertSigner),
      WriterSignerTrusted = iff(CertTrusted == true, 1, 0),
      WriterFileL   = tolower(coalesce(WriterFile, "")),
      WriterCLL     = tolower(coalesce(WriterCL, ""))
  | extend
      WriterTrustedPublisher = iff(WriterCompany in (TrustedPublishers) or (WriterSigner in (TrustedPublishers) and WriterSignerTrusted == 1), 1, 0),
      WriterTrustedInitiator = iff(WriterFileL in (TrustedInitiators), 1, 0)
  | join kind=leftouter OrgPrevalence on $left.WriterSHA == $right.SHA256
  | extend WriterDeviceCount = coalesce(WriterDeviceCount, 0)
  | extend WriterIsRare = iff(isnotempty(WriterSHA) and WriterDeviceCount <= 2, 1, 0);  // [FIX-2]

Enriched
| extend
    IsService   = iff(RK has "system\\currentcontrolset\\services", 1, 0),
    IsTaskCache = iff(RK has "schedule\\taskcache", 1, 0)
| extend
    ServiceImagePathWrite = iff(IsService == 1 and (RVN == "imagepath" or RVN has "imagepath"), 1, 0),
    HasDanger      = iff(RVD has_any (DangerTokens) or WriterCLL has_any (DangerTokens), 1, 0),
    HasBase64      = iff(RVD matches regex Base64ChunkedRx or WriterCLL matches regex Base64ChunkedRx, 1, 0),
    HasNet         = iff(RVD matches regex UrlRx or RVD matches regex IPv4Rx or RVD matches regex DomainRx, 1, 0),
    PointsWritable = iff(RVD matches regex UserWritableRx, 1, 0),
    IsLargeBlob    = iff(strlen(RVD) > PayloadSizeThreshold, 1, 0),
    IsSafePath     = iff(RVD has_any (SafePathAnchors), 1, 0),
    IsSafeVendor   = iff(RVD has_any (SafeVendorKeywords) or RVN has_any (SafeVendorKeywords), 1, 0),
    UntrustedWriter = iff(WriterTrustedPublisher == 0, 1, 0)
| where (IsService == 1 or IsTaskCache == 1)
| where (IsTaskCache == 1) or (ServiceImagePathWrite == 1) or (HasDanger == 1) or (PointsWritable == 1) or (IsLargeBlob == 1)
| where not(IsSafePath == 1 and IsSafeVendor == 1 and HasDanger == 0 and HasBase64 == 0 and HasNet == 0 and PointsWritable == 0 and IsLargeBlob == 0)
| where not(WriterTrustedInitiator == 1 and (HasDanger + HasBase64 + HasNet + PointsWritable + IsLargeBlob) == 0)
| extend
    BaseScore             = 55,
    Score_TaskCache       = 25 * IsTaskCache,
    Score_Service         = 20 * ServiceImagePathWrite,
    Score_Danger          = 25 * HasDanger,
    Score_Base64          = 20 * HasBase64,
    Score_Net             = 10 * HasNet,
    Score_Writable        = 15 * PointsWritable,
    Score_Blob            = 25 * IsLargeBlob,
    Score_UntrustedWriter = 10 * UntrustedWriter,
    Score_RareWriter      = 10 * WriterIsRare
| extend
    RiskScore = BaseScore + Score_TaskCache + Score_Service + Score_Danger
              + Score_Base64 + Score_Net + Score_Writable + Score_Blob
              + Score_UntrustedWriter + Score_RareWriter
| extend
    RiskLevel = case(RiskScore >= 120, "CRITICAL",
                     RiskScore >= 90,  "HIGH",
                     RiskScore >= 70,  "MEDIUM",
                                       "LOW")
| where RiskLevel in ("MEDIUM","HIGH","CRITICAL")
| extend _b64candidate = extract(@"([A-Za-z0-9+/]{40,}={0,2})", 1, tostring(RegistryValueData))   // [FIX-3]
| extend DecodedPayload = iif(isnotempty(_b64candidate), base64_decode_tostring(_b64candidate), "")
| project-away _b64candidate
| extend PersistenceClass = case(IsTaskCache == 1,          "TaskCache(SilentTask)",
                                 ServiceImagePathWrite == 1,"Service(ImagePath)",
                                                            "Background(Other)")
| extend HunterDirective = case(                                                                  // [FIX-4]
    RiskLevel == "CRITICAL" and PersistenceClass startswith "TaskCache",
        "CRITICAL: Silent Scheduled Task persistence via TaskCache (API/COM). Pull task definition, isolate if unauthorized, scope fleet for same task name/GUID.",
    RiskLevel == "CRITICAL" and PersistenceClass startswith "Service",
        "CRITICAL: Service persistence set (ImagePath). Validate service name + binary, check signer, collect binary, scope other hosts for same ImagePath.",
    RiskLevel == "HIGH",
        "HIGH: Background persistence registry artifact. Pivot to writer ancestry, recent file drops, hunt fleet for same RegistryValueData / WriterSHA.",
        "MEDIUM: Background persistence signal. Validate if approved updater/agent; if not, escalate and scope.")
// [DEPLOY] Timestamp, DeviceId and ReportId in the output: required to deploy as a Defender custom detection.
| project
    Timestamp, DeviceId, ReportId, DeviceName,
    AccountName = WriterUser,
    RegistryKey, RegistryValueName, RegistryValueData, DecodedPayload,
    PersistenceClass, WriterProcess = WriterFile, WriterCommandLine = WriterCL,
    WriterCompany, WriterSigner, WriterSHA, WriterDeviceCount,
    HasDanger, HasBase64, HasNet, PointsWritable, IsLargeBlob,
    RiskScore, RiskLevel, HunterDirective
| order by RiskScore desc, Timestamp desc
